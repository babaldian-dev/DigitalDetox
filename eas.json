{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_ANDROID_GRADLE_ARGS": "-PnewArchEnabled=false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_ANDROID_GRADLE_ARGS": "-PnewArchEnabled=false"
      }
    }
  }
}
